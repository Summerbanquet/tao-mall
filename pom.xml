<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>
    <groupId>com.campustao</groupId>
    <artifactId>campus-tao-svr</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>campus-tao-svr</name>
    <description>校园淘货平台后端（父聚合工程，只管版本不写代码）</description>
    <modules>
        <module>tao-common</module>
        <module>tao-web</module>
        <module>tao-user</module>
        <module>tao-goods</module>
        <module>tao-order</module>
        <module>tao-ai</module>
        <module>tao-notify</module>
        <module>tao-admin</module>
    </modules>
    <properties>
        <java.version>1.8</java.version>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块版本统一管理，子模块引用不写版本号 -->
            <dependency>
                <groupId>com.campustao</groupId>
                <artifactId>tao-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campustao</groupId>
                <artifactId>tao-user</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campustao</groupId>
                <artifactId>tao-goods</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campustao</groupId>
                <artifactId>tao-order</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campustao</groupId>
                <artifactId>tao-ai</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campustao</groupId>
                <artifactId>tao-notify</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campustao</groupId>
                <artifactId>tao-admin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-boot-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 所有子模块公用的最小依赖 -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>