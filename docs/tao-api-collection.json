          "name": "商品列表（分页）",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pageNum\": 1,\n  \"pageSize\": 12,\n  \"title\": \"\",\n  \"status\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/web/goods/page", "host": ["{{baseUrl}}"], "path": ["web", "goods", "page"] }
          }
        },
        {
          "name": "商品详情",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/web/goods/getInfo/1", "host": ["{{baseUrl}}"], "path": ["web", "goods", "getInfo", "1"] }
          }
        },
        {
          "name": "发布商品",
          "request": {
