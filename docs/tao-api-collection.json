{
  "info": {
    "name": "校园淘 - 接口集合",
    "description": "校园淘二手交易平台接口集合（Postman Collection v2.1，Apifox / Postman 均可直接导入）\n\n使用说明：\n1. 导入后先运行【用户 → 用户登录】，脚本会自动把返回的 token 写入集合变量 token\n2. 其余需要登录的接口已配置 Authorization: {{token}}，无需手动填写\n3. 集合变量 baseUrl 默认 http://localhost:8080，可按需修改",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "用户",
      "item": [
        {
          "name": "用户登录",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"test01\",\n  \"password\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/web/user/login", "host": ["{{baseUrl}}"], "path": ["web", "user", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.code === 200 && res.token) {",
                  "    pm.collectionVariables.set('token', res.token);",
                  "    console.log('token 已自动保存：' + res.token.substring(0, 20) + '...');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "用户注册",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"test02\",\n  \"password\": \"123456\",\n  \"name\": \"张三\",\n  \"nickName\": \"\",\n  \"phone\": \"13800138001\",\n  \"email\": \"zhangsan@tao.com\",\n  \"validateCode\": \"1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/web/user/register", "host": ["{{baseUrl}}"], "path": ["web", "user", "register"] }
          }
        },
        {
          "name": "校验用户名是否可用",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/web/user/checkUserName/test01", "host": ["{{baseUrl}}"], "path": ["web", "user", "checkUserName", "test01"] }
          }
        },
        {
          "name": "获取当前用户信息",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{token}}" }],
            "url": { "raw": "{{baseUrl}}/web/user/info", "host": ["{{baseUrl}}"], "path": ["web", "user", "info"] }
          }
        },
        {
          "name": "修改个人资料",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "{{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"张三\",\n  \"nickName\": \"考研ing\",\n  \"phone\": \"13900139000\",\n  \"email\": \"new@tao.com\",\n  \"avatar\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/web/user/info", "host": ["{{baseUrl}}"], "path": ["web", "user", "info"] }
          }
        },
        {
          "name": "退出登录",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "{{token}}" }],
            "url": { "raw": "{{baseUrl}}/web/user/logout", "host": ["{{baseUrl}}"], "path": ["web", "user", "logout"] }
          }
        }
      ]
    },
    {
      "name": "商品",
      "item": [
