              { "key": "Authorization", "value": "{{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": 0\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/web/goods/status/1", "host": ["{{baseUrl}}"], "path": ["web", "goods", "status", "1"] }
          }
        },
        {
          "name": "删除商品（逻辑删除）",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "{{token}}" }],
            "url": { "raw": "{{baseUrl}}/web/goods/dele/1", "host": ["{{baseUrl}}"], "path": ["web", "goods", "dele", "1"] }
          }
