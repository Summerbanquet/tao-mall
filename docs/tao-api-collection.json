            "body": {
              "mode": "raw",
              "raw": "{\n  \"pageNum\": 1,\n  \"pageSize\": 10\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/web/goods/my", "host": ["{{baseUrl}}"], "path": ["web", "goods", "my"] }
          }
