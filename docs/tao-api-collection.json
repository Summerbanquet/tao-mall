              "raw": "{\n  \"title\": \"九成新自行车\",\n  \"description\": \"毕业转让，车况良好\",\n  \"price\": 199.90,\n  \"cover\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/web/goods/add", "host": ["{{baseUrl}}"], "path": ["web", "goods", "add"] }
          }
        },
        {
          "name": "修改商品",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "{{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"title\": \"九成新自行车（已降价）\",\n  \"description\": \"毕业转让\",\n  \"price\": 150.00\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/web/goods/edit", "host": ["{{baseUrl}}"], "path": ["web", "goods", "edit"] }
          }
        },
